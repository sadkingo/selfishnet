<Window x:Class="SelfishNetModern.Views.TermsOfUseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Terms of Use &amp; Network Authorization Agreement"
        Icon="icon.ico"
        Height="540" Width="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border Background="#1E1E2E" CornerRadius="16" BorderBrush="#313244" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="5" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="44" Height="44" CornerRadius="12" Background="#F38BA8" Margin="0,0,14,0">
                    <TextBlock Text="🛡️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Terms of Use &amp; Authorized Use Agreement" FontSize="18" FontWeight="Bold" Foreground="#CDD6F4"/>
                    <TextBlock Text="Network Administration &amp; Testing Compliance" FontSize="13" Foreground="#A6ADC8"/>
                </StackPanel>
            </StackPanel>

            <!-- Terms Body Card -->
            <Border Grid.Row="1" Background="#181825" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#313244" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#313244" CornerRadius="6" Padding="10" Margin="0,0,0,12">
                            <TextBlock Text="⚠️ IMPORTANT: READ BEFORE USING THIS SOFTWARE" FontWeight="Bold" Foreground="#FAB387" FontSize="12"/>
                        </Border>

                        <TextBlock Text="1. Authorized Network Testing Only" FontWeight="SemiBold" Foreground="#89B4FA" FontSize="14" Margin="0,4,0,2"/>
                        <TextBlock Text="This software is designed exclusively for network administrators and authorized users to inspect, benchmark, and manage bandwidth allocation on local area networks (LANs) that they own or have received explicit written permission to administer." 
                                   TextWrapping="Wrap" Foreground="#BAC2DE" FontSize="12" Margin="0,0,0,10" LineHeight="17"/>

                        <TextBlock Text="2. Prohibition of Unauthorized Interception" FontWeight="SemiBold" Foreground="#89B4FA" FontSize="14" Margin="0,4,0,2"/>
                        <TextBlock Text="ARP cache manipulation, packet redirection, and traffic throttling without explicit consent on networks not owned by you (such as public Wi-Fi hotspots, school, or corporate networks) is strictly prohibited by law and cybersecurity statutes." 
                                   TextWrapping="Wrap" Foreground="#BAC2DE" FontSize="12" Margin="0,0,0,10" LineHeight="17"/>

                        <TextBlock Text="3. User Sole Responsibility &amp; Liability" FontWeight="SemiBold" Foreground="#89B4FA" FontSize="14" Margin="0,4,0,2"/>
                        <TextBlock Text="By checking the confirmation below and proceeding, you attest that you are operating this software 100% within your own owned private network or an explicitly authorized test lab environment." 
                                   TextWrapping="Wrap" Foreground="#BAC2DE" FontSize="12" LineHeight="17"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Checkbox -->
            <Border Grid.Row="2" Background="#11111B" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                <CheckBox x:Name="AgreementCheckBox" Checked="OnCheckBoxChanged" Unchecked="OnCheckBoxChanged" VerticalContentAlignment="Center">
                    <TextBlock Text="I certify that I am testing this software ONLY on my own private network." 
                               Foreground="#CDD6F4" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap"/>
                </CheckBox>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="Decline &amp; Exit" Height="42" Background="#313244" Foreground="#BAC2DE" 
                        FontSize="13" FontWeight="SemiBold" Click="OnDeclineClicked" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="AcceptButton" Grid.Column="2" Content="Accept &amp; Continue" Height="42" 
                        Background="#89B4FA" Foreground="#11111B" FontSize="13" FontWeight="Bold" 
                        IsEnabled="False" Click="OnAcceptClicked" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
