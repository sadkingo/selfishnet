<Window x:Class="SelfishNetModern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SelfishNetModern.ViewModels"
        Title="SelfishNet Modern - Network Bandwidth Controller &amp; Traffic Manager" 
        Height="780" Width="1200"
        MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Telemetry Cards -->
            <RowDefinition Height="Auto"/>
            <!-- Actions Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Main Device Table -->
            <RowDefinition Height="*"/>
            <!-- Bottom Status Bar / Event Log -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceDark}" CornerRadius="12" Padding="16,12" Margin="0,0,0,16" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand / Logo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource AccentBlue}" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SelfishNet" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextLight}"/>
                            <TextBlock Text=" MODERN" FontSize="18" FontWeight="ExtraBold" Foreground="{StaticResource AccentBlue}"/>
                            <Border Background="#313244" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v2.0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="High-Precision Local Network Bandwidth Allocator" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Interface Selector & Status Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Interface:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}" DisplayMemberPath="DisplayName" 
                              Width="340" Height="32" VerticalContentAlignment="Center" Background="#181825" Foreground="{StaticResource TextLight}"/>
                    
                    <Button Command="{Binding RefreshAdaptersCommand}" Content="🔄" Width="32" Height="32" Margin="6,0,14,0" 
                            Style="{StaticResource ModernButton}" ToolTip="Refresh Adapters"/>

                    <!-- Local IP Pill -->
                    <Border Background="#181825" CornerRadius="6" Padding="10,6" Margin="0,0,8,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💻 IP: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock Text="{Binding MyIpDisplay}" Foreground="{StaticResource TextLight}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Gateway Pill -->
                    <Border Background="#181825" CornerRadius="6" Padding="10,6" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐 Gateway: " Foreground="{StaticResource TextMuted}" FontSize="11"/>
                            <TextBlock Text="{Binding GatewayDisplay}" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right Header Actions (Terms & Help) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding ShowTermsCommand}" Content="🛡️ Terms of Use" Style="{StaticResource ModernButton}" 
                            Background="#252538" Foreground="{StaticResource TextMuted}" FontSize="11" Padding="10,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. TELEMETRY CARDS -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card 1: Total Devices -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceDark}" CornerRadius="10" Padding="16,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="DISCOVERED DEVICES" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <TextBlock Text="{Binding TotalDeviceCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextLight}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 2: Controlled Devices -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceDark}" CornerRadius="10" Padding="16,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="REDIRECTED / BLOCKED" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextMuted}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding ControlledDeviceCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentPurple}"/>
                        <TextBlock Text=" / " FontSize="20" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BlockedDeviceCount}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentRed}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Card 3: Total Download -->
            <Border Grid.Column="4" Background="{StaticResource SurfaceDark}" CornerRadius="10" Padding="16,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL DOWNLOAD SPEED" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                    <TextBlock Text="{Binding TotalDownloadDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentGreen}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Card 4: Total Upload -->
            <Border Grid.Column="6" Background="{StaticResource SurfaceDark}" CornerRadius="10" Padding="16,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="TOTAL UPLOAD SPEED" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                    <TextBlock Text="{Binding TotalUploadDisplay}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 3. ACTIONS TOOLBAR -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceDark}" CornerRadius="10" Padding="14,10" Margin="0,0,0,16" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Scan Button -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Command="{Binding ScanCommand}" Style="{StaticResource ModernButton}" Background="{StaticResource AccentBlue}" Foreground="#11111B" 
                            Content="🔍 Scan Network" Height="36" Padding="18,0" Margin="0,0,12,0"/>
                    
                    <!-- Redirect Start/Stop Button -->
                    <Button Command="{Binding ToggleRedirectCommand}" 
                            Content="{Binding RedirectButtonText}" Height="36" Padding="18,0" Margin="0,0,12,0" FontWeight="Bold">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRedirecting}" Value="True">
                                        <Setter Property="Background" Value="#F38BA8"/>
                                        <Setter Property="Foreground" Value="#11111B"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsRedirecting}" Value="False">
                                        <Setter Property="Background" Value="#A6E3A1"/>
                                        <Setter Property="Foreground" Value="#11111B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Scan Progress Bar (Visible when scanning) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0" Width="180">
                    <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding ScanProgress}" 
                                 Foreground="{StaticResource AccentBlue}" Background="#181825" BorderThickness="0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>

                <!-- Quick Batch Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Command="{Binding BlockAllCommand}" Content="🚫 Block All" Style="{StaticResource ModernButton}" 
                            Background="#313244" Foreground="{StaticResource AccentRed}" Height="34" Margin="0,0,8,0" Padding="12,0"/>
                    <Button Command="{Binding UnblockAllCommand}" Content="🔓 Unblock All" Style="{StaticResource ModernButton}" 
                            Background="#313244" Foreground="{StaticResource AccentGreen}" Height="34" Margin="0,0,8,0" Padding="12,0"/>
                    <Button Command="{Binding ResetAllLimitsCommand}" Content="🔄 Reset All" Style="{StaticResource ModernButton}" 
                            Background="#313244" Foreground="{StaticResource TextLight}" Height="34" Padding="12,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. MAIN DEVICE TABLE -->
        <Border Grid.Row="3" Background="{StaticResource SurfaceDark}" CornerRadius="12" Padding="2" Margin="0,0,0,14" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Devices}" AutoGenerateColumns="False" CanUserAddRows="False" 
                      Background="Transparent" BorderThickness="0" RowBackground="#181825" AlternatingRowBackground="#151520"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#252538"
                      HeadersVisibility="Column" SelectionMode="Single" SelectionUnit="FullRow">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1E1E2E"/>
                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11.5"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{StaticResource TextLight}"/>
                        <Setter Property="FontSize" Value="12.5"/>
                        <Setter Property="Height" Value="48"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252538"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <!-- Device Type & Status Icon -->
                    <DataGridTemplateColumn Header="Type" Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DeviceTypeIcon}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- IP Address -->
                    <DataGridTemplateColumn Header="IP Address" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding IP}" FontWeight="Bold" VerticalAlignment="Center" Foreground="{StaticResource TextLight}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- MAC Address -->
                    <DataGridTemplateColumn Header="MAC Address" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MacString}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Hostname & Vendor -->
                    <DataGridTemplateColumn Header="Device / Manufacturer" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Hostname}" FontWeight="SemiBold" Foreground="{StaticResource TextLight}"/>
                                    <TextBlock Text="{Binding Vendor}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status Badge -->
                    <DataGridTemplateColumn Header="Status" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" VerticalAlignment="Center" Background="#252538">
                                    <TextBlock Text="{Binding StatusDescription}" Foreground="{Binding StatusColor}" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Live Download Rate -->
                    <DataGridTemplateColumn Header="Download Rate" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DownloadSpeedDisplay}" Foreground="{StaticResource AccentGreen}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Live Upload Rate -->
                    <DataGridTemplateColumn Header="Upload Rate" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UploadSpeedDisplay}" Foreground="{StaticResource AccentOrange}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Download Cap (KB/s) -->
                    <DataGridTemplateColumn Header="Cap Download (KB/s)" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding DownloadLimitKbps, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="28"/>
                                    <TextBlock Text="KB/s" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Upload Cap (KB/s) -->
                    <DataGridTemplateColumn Header="Cap Upload (KB/s)" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBox Text="{Binding UploadLimitKbps, UpdateSourceTrigger=PropertyChanged}" Width="75" Height="28"/>
                                    <TextBlock Text="KB/s" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Redirect Control CheckBox -->
                    <DataGridTemplateColumn Header="Redirect" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsControlled, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGateway}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Block Toggle Button -->
                    <DataGridTemplateColumn Header="Block" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="BLOCK" Width="64" Height="28" FontWeight="Bold" FontSize="11"
                                        Command="{Binding DataContext.ToggleBlockDeviceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                            <Setter Property="Background" Value="#313244"/>
                                            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsBlocked}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource AccentRed}"/>
                                                    <Setter Property="Foreground" Value="#11111B"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsGateway}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelf}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 5. BOTTOM STATUS BAR & RESILIENCE INDICATOR -->
        <Border Grid.Row="4" Background="{StaticResource SurfaceDark}" CornerRadius="10" Padding="14,10" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Health / Auto-Reconnect Indicator Dot -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{Binding HealthColor}" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextLight}" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Auto-reconnect banner -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#181825" CornerRadius="6" Padding="12,4" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄 Auto-Reconnect Engine: Active" Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="SemiBold"/>
                        <TextBlock Text=" (Guards against Wi-Fi drops &amp; Router resets)" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="4,0,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Disclaimer Badge -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#252538" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="🔒 Authorized Network Only" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
